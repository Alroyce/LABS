------------------------- Single Instance -----------------------------------------------------------------------------------------------------------------------

# create resource.tf file like :-
# ec2.tf
= resource "aws_instance" "web-server" {  -- resource -keyword, aws_instance -- provider keyword, web-server -- purpose what you want to do.
ami = "ami-0c24c764e44ed98f2"
tags = {
  Name = "terra_user"
}
instance_type = "t3.micro"
count = 2
key_name = "key"
security_group = "launch-wizard-3"
}


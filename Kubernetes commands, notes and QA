# we should update rules in the pod

# kubectl apply -f https://raw.githubusercontent.com/lerndevops/kubernetes/master/6-networking/ingress/app-ingress-rules.yaml
= apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: apps-ingress-rule
  annotations:
    ingress.kubernetes.io/rewrite-target: /
spec:
  ingressClassName: nginx
  rules:
  - http:
      paths:
        - path: /                      -- if only / then route to this pod
          pathType: Prefix
          backend:
            service:
              name: nginx-custom-default-backend
              port:
                number: 80
        - path: /unapp                 -- if we type this it wil execute the below app.
          pathType: Prefix
          backend:
            service:
              name: unapp-svc
              port:
                number: 80
        - path: /pyapp
          pathType: Prefix
          backend:
            service:
              name: pyapp-svc
              port:
                number: 80
        - path: /petclinic
          pathType: Prefix
          backend:
            service:
              name: petclinic-svc
              port:
                number: 80


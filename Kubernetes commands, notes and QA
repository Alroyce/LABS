#  Deployment controller 

# the purpose of deployment is to run multiple pods.

# deployment manifest file
# difference is deployment and pod manifest file is - deployment file containes the number of replicas
# in spec:
      replicas: 4 -- no of pods
      template:     
      metadata: 
      spec: 
       containers:
        - name: cont1
          image: nginx
        - name: cont2
          image: lerndevops/sampleapp:v1

#-----------------------------------------
# kind: deployment
apiVersion: apps/v1
metadata: 
 name: pyapp
 namespace: teama
 labels: 
  name: newapp
  env: dev
  roles: webapp
spec: 
 replicas: 4
 selector:
  matchLabels: # we are tell the controller to match only the pods having the labels.
    app: myapp
 template: 
  metadata: 
   # name: name auto generated by controller
   # namespace: will be enforced by controller to pods automatically.
   labels: 
     app: myapp
 spec: 
  containers: 
   - name: cont1
     image: nginx
   - name: cont2
     image: tomcat

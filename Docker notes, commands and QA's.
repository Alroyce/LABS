# what is Dockerfile ?
= Dockerfile is a plain text file which contains all the commands & instuction to assemble a automated image.
= its has 15 pre-defined keywords.
= FROM, RUN, WORKDIR, COPY, CMD

#EXAMPLE DOCKER FILE.
= Docker example
  FROM TOMCAT:10.0.1
  RUN apt-get update
  RUN apt-get install
  TOUCH abc.txt
  RUN wget https...............
= or RUN cd/usr/tomcat/webapps wget https://git.....................

# how to create a own image using the following, like tomcat, jdk, and sampleapp.war files from git.?
= download the files java wget jdk.1.......
  download the files tomcat wget tomcat ................
  download the files app wget sampleapp.war...........
  
  expand the tar file - tar -xzf jdk
  expand the tar file - tar -xzf tomcat

  create the file -- name -- vi dfile.
  FROM ubuntu:10.04
  ADD jdk.....   /opt - add the file to the directory
  ADD jdk.....   /opt
  RUN mv /opt/jdk....... /opt/java
  RUN mv /opt/tomcat..... /opt/tomcat
  COPY sampleapp.war /opt/tomcat/webapps                       ADD - copys the whole folder.
  ENV JAVA_HOME /opt/java             - Java home              COPY - copys only the contents.
  ENV JAVA_VERSION 1.11             
  EXPOSE 8090                          - set the port
  CMD ["/opt/tomcat/bin/startup.sh", "run"]
OR
  CMD ["bash","/opt/tomcat/bin/startup.sh"] - CMD executes the command.

